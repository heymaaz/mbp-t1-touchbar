#!/bin/bash
# Apple T1 Touch Bar bring-up. Installed as /usr/local/bin/touchbar-t1-setup
# and run by touchbar-t1.service.
#
# Takes the iBridge from its power-on state (USB configuration 1) to a lit,
# touch-capable Touch Bar:
#
#   1. load the modules
#   2. register 05ac:8600 with hid-multitouch as MT_CLS_APPLE_TOUCHBAR, BEFORE
#      switching configuration, so hid-multitouch wins the probe race against
#      hid-generic when configuration 2 enumerates
#   3. switch to USB configuration 2 (the only one with the DFR display
#      interface, class 0x10)
#   4. wait for appletbdrm to bind, then replay the macOS activation sequence
#   5. turn the panel on
#
# Idempotent: safe to re-run. Exits non-zero only if the Touch Bar cannot be
# brought up, so tiny-dfr.service (Requires=) will not start into a dead device.
set -u

VID=05ac
PID=8600
FALLBACK_MT_CLS=114        # hex; MT_CLS_APPLE_TOUCHBAR as of Linux 6.15-7.1

log() { echo "touchbar-t1: $*"; }

# --------------------------------------------------------------- find the device
# The USB path differs between machines (1-3 here, 5-6 and 7-6 reported
# elsewhere), so locate it by vendor/product rather than hardcoding.
find_ibridge() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] && [ -r "$d/idProduct" ] || continue
        [ "$(cat "$d/idVendor")" = "$VID" ] && [ "$(cat "$d/idProduct")" = "$PID" ] || continue
        echo "$d"
        return 0
    done
    return 1
}

wait_for() {   # $1 = path, $2 = timeout seconds
    local i=0
    while [ ! -e "$1" ]; do
        i=$((i+1))
        [ "$i" -ge "$2" ] && return 1
        sleep 1
    done
    return 0
}

# ---------------------------------------- MT_CLS_APPLE_TOUCHBAR, read from the kernel
# hid-multitouch already carries the Apple Touch Bar class for the T2's
# 05ac:8302. Rather than hardcode the enum value (which upstream could
# renumber, silently binding us to the wrong class), read the driver_data of
# the 8302 entry out of the module that is actually installed.
mt_class() {
    local ko
    ko=$(modinfo -n hid-multitouch 2>/dev/null) || { echo "$FALLBACK_MT_CLS"; return; }
    python3 - "$ko" <<'PY' 2>/dev/null || echo "$FALLBACK_MT_CLS"
import re, subprocess, sys
p = sys.argv[1]
data = (subprocess.run(['zstd','-dc',p], capture_output=True).stdout
        if p.endswith('.zst') else open(p,'rb').read())
if not data:
    sys.exit(1)
# struct hid_device_id { u16 bus; u16 group; u32 vendor; u32 product;
#                        <4 pad>; kernel_ulong_t driver_data; }  == 24 bytes
pat = bytes.fromhex('03000000') + bytes.fromhex('ac050000') + bytes.fromhex('02830000')
m = re.search(re.escape(pat), data)
if not m:
    sys.exit(1)
dd = int.from_bytes(data[m.start()+16:m.start()+24], 'little')
if not 0 < dd < 0x10000:
    sys.exit(1)
print(f'{dd:x}')
PY
}

# ---------------------------------------------------------------------- 1. modules
for m in uinput hid_multitouch appletbdrm hid_appletb_bl; do
    modprobe "$m" 2>/dev/null || log "warning: modprobe $m failed"
done

USB=$(find_ibridge) || {
    # The device can take a moment to appear on a cold boot.
    for _ in $(seq 30); do sleep 1; USB=$(find_ibridge) && break; done
}
[ -n "${USB:-}" ] || { log "no $VID:$PID iBridge found - nothing to do"; exit 1; }
BUSID=$(basename "$USB")
log "iBridge at $BUSID"

# ------------------------------------------------------ 2. hid-multitouch dynamic id
# The T1 digitizer is the same device class as the T2's, with a different
# product id. Registering it here means hid-generic does not claim it first.
MTCLS=$(mt_class)
[ "$MTCLS" = "$FALLBACK_MT_CLS" ] || log "MT_CLS_APPLE_TOUCHBAR read from kernel: 0x$MTCLS"
NEWID=/sys/bus/hid/drivers/hid-multitouch/new_id
if [ -w "$NEWID" ]; then
    if echo "0003 ${VID^^} ${PID^^} $MTCLS" > "$NEWID" 2>/dev/null; then
        log "registered $VID:$PID with hid-multitouch (class 0x$MTCLS)"
    else
        log "new_id already registered, or rejected - continuing"
    fi
else
    log "warning: $NEWID not writable"
fi

# -------------------------------------------------------------- 3. USB configuration 2
CFG=$(cat "$USB/bConfigurationValue" 2>/dev/null || echo 0)
if [ "$CFG" != 2 ]; then
    log "switching USB configuration $CFG -> 2"
    echo 2 > "$USB/bConfigurationValue" || { log "configuration switch failed"; exit 1; }
    sleep 3
fi
CFG=$(cat "$USB/bConfigurationValue" 2>/dev/null || echo 0)
[ "$CFG" = 2 ] || { log "still on configuration $CFG - aborting"; exit 1; }

# ------------------------------------------------------- 4. wait for the DFR display
if ! wait_for "$USB:2.3/driver" 20; then
    log "appletbdrm did not bind to $BUSID:2.3 - aborting"
    exit 1
fi
log "$BUSID:2.3 -> $(readlink "$USB:2.3/driver" | xargs basename)"

# ------------------------------------------------- 5. digitizer on hid-multitouch
DIG=$(basename "$(ls -d "$USB:2.2"/0003:* 2>/dev/null | head -1)")
if [ -n "$DIG" ]; then
    CUR=$(readlink "/sys/bus/hid/devices/$DIG/driver" 2>/dev/null | xargs -r basename)
    if [ "$CUR" != hid-multitouch ]; then
        log "digitizer on ${CUR:-nothing} - rebinding to hid-multitouch"
        [ -n "$CUR" ] && echo -n "$DIG" > "/sys/bus/hid/drivers/$CUR/unbind" 2>/dev/null
        sleep 1
        echo -n "$DIG" > /sys/bus/hid/drivers_probe 2>/dev/null
        sleep 2
        CUR=$(readlink "/sys/bus/hid/devices/$DIG/driver" 2>/dev/null | xargs -r basename)
        if [ -z "$CUR" ]; then
            log "rebind left it unbound - restoring hid-generic"
            echo -n "$DIG" > /sys/bus/hid/drivers/hid-generic/bind 2>/dev/null
            CUR=hid-generic
        fi
    fi
    log "digitizer $DIG -> $CUR"
    [ "$CUR" = hid-multitouch ] || log "warning: touch will not work on $CUR"
else
    log "warning: no HID device under $BUSID:2.2"
fi

# ---------------------------------------------------------- 6. activation + panel
if [ -x /usr/local/bin/touchbar-activate ]; then
    /usr/local/bin/touchbar-activate 2>&1 | sed 's/^/touchbar-t1: /'
else
    log "warning: /usr/local/bin/touchbar-activate missing"
fi

BL=/sys/class/backlight/appletb_backlight/brightness
if wait_for "$BL" 10; then
    echo 2 > "$BL" 2>/dev/null && log "panel on (brightness $(cat "$BL"))"
else
    log "appletb_backlight missing - tiny-dfr will refuse to start"
    exit 1
fi

log "ready"
exit 0
