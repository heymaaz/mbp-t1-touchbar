#!/usr/bin/env python3
"""Hyprland-aware Touch Bar layouts.

Watches Hyprland's IPC event stream and rewrites /etc/tiny-dfr/config.toml
when the focused window changes, so the Touch Bar can show a different set of
keys per application.

Why this works without patching tiny-dfr
----------------------------------------
tiny-dfr already keeps an inotify watch on /etc/tiny-dfr/config.toml
(IN_MOVED_TO | IN_CLOSE | IN_ONESHOT) and reloads both layers in-place when it
fires, resetting to the default layer. Writing the file atomically - temp file
in the same directory, then rename(2) - is therefore the entire integration.
No restart, no IPC, no patch.

Why this is a system service and not a --user one
-------------------------------------------------
tiny-dfr's config path is a hardcoded constant (/etc/tiny-dfr/config.toml); it
reads no XDG path. A user unit cannot write there. Running as root instead lets
us both write that file and read the Hyprland sockets under /run/user/*/hypr/,
without loosening permissions on /etc or maintaining a fifth tiny-dfr patch.

Layout selection is entirely data-driven; see /etc/tiny-dfr/layouts.toml.
If no rule matches, the base configuration is written unchanged, so the default
Touch Bar is always what you get for unrecognised windows.
"""
import glob
import json
import os
import re
import shutil
import select
import socket
import sys
import time
import tomllib

LAYOUTS_PATH = '/etc/tiny-dfr/layouts.toml'
CONFIG_PATH = '/etc/tiny-dfr/config.toml'
BACKUP_PATH = '/etc/tiny-dfr/config.toml.pre-appmap'
GENERATED_MARK = '# Generated by touchbar-t1-appmap'

# Rewriting the config forces tiny-dfr into a complete redraw and a full
# 2170x60 frame push over USB bulk, so rapid alt-tabbing must not thrash it.
SETTLE_SECONDS = 0.15
RECONNECT_SECONDS = 3.0


def log(*args):
    print('touchbar-t1-appmap:', *args, flush=True)


# --------------------------------------------------------------------- TOML out
# tomllib reads but does not write. The value space here is small and fully
# determined by layouts.toml, so a tiny emitter is both sufficient and stricter
# than pasting raw text through: a malformed layout fails loudly on load.

def toml_scalar(value):
    if isinstance(value, bool):
        return 'true' if value else 'false'
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        return '[' + ', '.join(toml_scalar(v) for v in value) + ']'
    raise TypeError(f'unsupported value: {value!r}')


def toml_inline_table(mapping):
    body = ', '.join(f'{k} = {toml_scalar(v)}' for k, v in mapping.items())
    return '{ ' + body + ' }'


def toml_value(value):
    if isinstance(value, list) and value and isinstance(value[0], dict):
        rows = ',\n'.join('    ' + toml_inline_table(v) for v in value)
        return '[\n' + rows + '\n]'
    return toml_scalar(value)


def render(layouts, name):
    """Render the tiny-dfr config for one layout name (None = base only)."""
    merged = dict(layouts.get('base', {}))
    if name:
        merged.update(layouts.get('layout', {}).get(name, {}))

    lines = [
        GENERATED_MARK + ' - do not edit.',
        '# Edit ' + LAYOUTS_PATH + ' instead; this file is rewritten on',
        '# every focus change. Active layout: ' + (name or '(default)'),
        '',
    ]
    for key, value in merged.items():
        lines.append(f'{key} = {toml_value(value)}')
    return '\n'.join(lines) + '\n'


# ------------------------------------------------------------------- rule match
def compile_rules(layouts):
    """Compile [[rule]] entries once. First match wins, in file order."""
    rules = []
    for index, rule in enumerate(layouts.get('rule', [])):
        name = rule.get('layout')
        if not name:
            log(f'rule {index}: no layout name, ignored')
            continue
        if name not in layouts.get('layout', {}):
            log(f'rule {index}: no [layout.{name}] section, ignored')
            continue
        try:
            patterns = {
                field: re.compile(rule[field])
                for field in ('class', 'title') if field in rule
            }
        except re.error as exc:
            log(f'rule {index} ({name}): bad regex, ignored: {exc}')
            continue
        rules.append((name, patterns))
    return rules


def select_layout(rules, window_class, window_title):
    subject = {'class': window_class, 'title': window_title}
    for name, patterns in rules:
        if all(p.search(subject[f]) for f, p in patterns.items()):
            return name
    return None


# ------------------------------------------------------------------ config file
def load_layouts():
    with open(LAYOUTS_PATH, 'rb') as handle:
        return tomllib.load(handle)


def preserve_existing_config():
    """Back up a hand-written config.toml once, before we start owning it.

    Copied rather than moved: config.toml must never be missing, or tiny-dfr
    would reload with its shipped defaults - F1-F12 instead of media keys -
    until our first write lands.
    """
    if not os.path.exists(CONFIG_PATH) or os.path.exists(BACKUP_PATH):
        return
    with open(CONFIG_PATH) as handle:
        if GENERATED_MARK in handle.read(len(GENERATED_MARK) + 64):
            return
    shutil.copy2(CONFIG_PATH, BACKUP_PATH)
    log(f'preserved your existing config as {BACKUP_PATH}')


def write_config(text):
    """Atomic rename into place - this is what tiny-dfr's inotify watch sees."""
    try:
        with open(CONFIG_PATH) as handle:
            if handle.read() == text:
                return False
    except OSError:
        pass
    tmp = CONFIG_PATH + '.tmp'
    with open(tmp, 'w') as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(tmp, 0o644)
    os.replace(tmp, CONFIG_PATH)
    return True


# --------------------------------------------------------------------- Hyprland
def find_socket_dir():
    """Newest $XDG_RUNTIME_DIR/hypr/<signature>/ across all logged-in users.

    Hyprland mints a fresh signature per compositor start, so the newest
    directory is the live session. This targets a single-seat laptop; with two
    concurrent Hyprland sessions the most recent one wins.
    """
    candidates = glob.glob('/run/user/*/hypr/*/.socket2.sock')
    if not candidates:
        return None
    newest = max(candidates, key=lambda p: os.stat(p).st_mtime)
    return os.path.dirname(newest)


def hypr_command(socket_dir, command):
    """One request on .socket.sock - the same channel hyprctl uses."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(2)
        sock.connect(os.path.join(socket_dir, '.socket.sock'))
        sock.sendall(command.encode())
        chunks = []
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
    return b''.join(chunks)


def active_window(socket_dir):
    """Seed state on connect, so a restart does not wait for a focus change."""
    try:
        payload = json.loads(hypr_command(socket_dir, 'j/activewindow') or b'{}')
    except (OSError, ValueError) as exc:
        log(f'could not read the active window: {exc}')
        return '', ''
    return payload.get('class', ''), payload.get('title', '')


# ------------------------------------------------------------------- main loop
class Session:
    def __init__(self):
        self.layouts = load_layouts()
        self.rules = compile_rules(self.layouts)
        self.layouts_mtime = os.stat(LAYOUTS_PATH).st_mtime
        self.applied = object()          # sentinel: nothing written yet
        self.pending = None
        self.deadline = None

    def reload_layouts_if_changed(self):
        try:
            mtime = os.stat(LAYOUTS_PATH).st_mtime
        except OSError:
            return
        if mtime == self.layouts_mtime:
            return
        try:
            self.layouts = load_layouts()
            self.rules = compile_rules(self.layouts)
        except (OSError, tomllib.TOMLDecodeError) as exc:
            log(f'{LAYOUTS_PATH} is unreadable, keeping the previous rules: {exc}')
            return
        self.layouts_mtime = mtime
        self.applied = object()          # force a rewrite under the new rules
        log('reloaded layout rules')

    def focus(self, window_class, window_title):
        """Record a focus change; debounce the write until things settle."""
        name = select_layout(self.rules, window_class, window_title)
        if name == self.pending:
            return
        self.pending = name
        self.deadline = time.monotonic() + SETTLE_SECONDS

    def flush(self):
        """Apply the pending layout once it has settled."""
        if self.deadline is None or time.monotonic() < self.deadline:
            return
        self.deadline = None
        if self.pending == self.applied:
            return
        try:
            changed = write_config(render(self.layouts, self.pending))
        except (OSError, TypeError) as exc:
            log(f'could not write {CONFIG_PATH}: {exc}')
            return
        self.applied = self.pending
        if changed:
            log(f'layout -> {self.pending or "(default)"}')

    def timeout(self):
        if self.deadline is None:
            return 1.0
        return max(0.0, min(1.0, self.deadline - time.monotonic()))


def run_session(session):
    socket_dir = find_socket_dir()
    if socket_dir is None:
        return
    log(f'watching {os.path.basename(socket_dir)}')

    session.focus(*active_window(socket_dir))

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(os.path.join(socket_dir, '.socket2.sock'))
        buffer = b''
        while True:
            session.reload_layouts_if_changed()
            session.flush()

            ready, _, _ = select.select([sock], [], [], session.timeout())
            if not ready:
                continue
            chunk = sock.recv(65536)
            if not chunk:
                log('Hyprland closed the event stream')
                return
            buffer += chunk
            while b'\n' in buffer:
                line, buffer = buffer.split(b'\n', 1)
                handle_event(session, line.decode('utf-8', 'replace'))


def handle_event(session, line):
    event, _, data = line.partition('>>')
    # activewindow carries "CLASS,TITLE"; a title may itself contain commas,
    # and both are empty when the last window on a workspace closes.
    if event == 'activewindow':
        window_class, _, window_title = data.partition(',')
        session.focus(window_class, window_title)


def main():
    if not os.path.exists(LAYOUTS_PATH):
        log(f'{LAYOUTS_PATH} missing - nothing to do')
        return 1
    try:
        preserve_existing_config()
    except OSError as exc:
        log(f'could not preserve the existing config: {exc}')
        return 1

    session = Session()
    while True:
        try:
            run_session(session)
        except (OSError, ValueError) as exc:
            log(f'session ended: {exc}')
        time.sleep(RECONNECT_SECONDS)


if __name__ == '__main__':
    sys.exit(main())
